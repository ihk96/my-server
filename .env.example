# [설명] 배포 시 주입할 설정값의 레퍼런스 목록이다. 배포 서버에서는 이 파일을 참고해
# /etc/my-server/env 같은 파일을 만들고, systemd unit의 EnvironmentFile=로 읽힌다
# (README의 "서버에서 실행하기" 참고). 이 파일 자체는 어디에서도 읽히지 않는다.
#
# [주의] 개발 머신의 .env는 용도가 다르다. 그쪽은 sqlx-cli와 매크로가 DB에 붙기 위한
# DATABASE_URL 한 줄이면 충분하며, 아래 값들을 복사해 올 이유가 없다.

# 필수 — 없으면 기동 시 즉시 실패한다.
#
# [설명] SQLite라 호스트도 포트도 계정도 없다. 그냥 파일 경로다. 파일이 없으면 서버가
# 만들고(store/mod.rs의 create_if_missing), 마이그레이션까지 스스로 돌린다.
#
# [주의] WAL 모드라 옆에 `-wal`, `-shm` 파일이 함께 생긴다. 그러니 이 경로는 프로세스가
# **쓰기 권한을 가진 디렉토리**여야 한다 — 파일 하나만 쓸 수 있으면 되는 게 아니다.
# 배포 서버에서는 systemd의 StateDirectory=가 만들어주는 /var/lib/my-server를 쓴다.
#
# 개발 머신에서는 프로젝트 루트의 파일 하나면 충분하다(.gitignore에 들어 있다):
#   DATABASE_URL=sqlite://dev.db
DATABASE_URL=sqlite:///var/lib/my-server/my-server.db

# 나머지는 전부 기본값이 있다(config.rs 참고). 필요할 때만 덮어쓴다.
# [주의] 앞에 Caddy를 두는 구성이므로 배포 서버에서는 **127.0.0.1로 바인딩한다.**
# 0.0.0.0으로 열면 프록시를 우회해 앱에 직접 붙을 수 있고, 그러면 아래 레이트 리밋이
# 신뢰하는 x-forwarded-for 헤더를 누구나 위조할 수 있게 된다(routes/rate_limit.rs 참고).
# 루프백에만 붙이면 방화벽에서 8080을 열 필요도 없다.
# SERVER_ADDR=127.0.0.1:8080

# CORS로 허용할 오리진. 쉼표로 구분하며, 비워 두면 CORS 자체가 꺼진다(기본값).
# 브라우저에서 다른 오리진으로 이 API를 직접 호출할 때만 필요하다.
#
# [주의] 스킴까지 정확히. 브라우저가 보내는 Origin 헤더는 "스킴+호스트+포트" 형태이고
# 문자열로 비교되므로, example.com처럼 적거나 끝에 /를 붙이면 아무 요청과도 맞지 않는다.
# CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com

# 레이트 리밋(IP당). 아래 두 값이 각각 "순간 허용치"와 "지속 허용치"다.
#
# 브라우저는 페이지 하나를 열 때 요청 여럿을 동시에 쏘므로 버스트는 넉넉히 잡는다 —
# 짜게 잡으면 평범한 사용자가 새로고침만으로 429를 맞는다. 반대로 꾸준히 긁는 크롤러나
# 무차별 시도를 막는 것은 per_second 쪽이므로 그건 낮게 유지한다.
#
# /health와 /ready는 리밋에서 제외된다 — 감시 트래픽이 리밋을 갉아먹지 않도록.
# RATE_LIMIT_BURST=30
# RATE_LIMIT_PER_SECOND=5

# 요청 하나가 핸들러에서 끝나기까지 허용하는 시간. 초과하면 408.
#
# [주의] SQLite에는 Postgres의 statement_timeout에 해당하는 것이 없어서, "쿼리가 안
# 끝나는" 경우를 막는 그물은 사실상 이 값 하나뿐이다.
# REQUEST_TIMEOUT_SECS=30
# 종료 신호 후 백그라운드 태스크를 기다리는 상한. systemd의 TimeoutStopSec보다 짧게 잡을 것.
# SHUTDOWN_TIMEOUT_SECS=10
# RUST_LOG=info
# 커넥션 풀 크기. SQLite는 쓰기가 언제나 한 번에 하나라 이 값을 키워도 처리량이 따라
# 오르지 않는다 — 사실상 "동시에 읽는 수"다.
# DB_MAX_CONNECTIONS=4
# DB_ACQUIRE_TIMEOUT_SECS=10
# 다른 커넥션이 쥔 쓰기 락을 기다리는 상한. 넘으면 `database is locked` 에러가 난다.
# DB_BUSY_TIMEOUT_SECS=5
# 스케줄 job(domain/jobs.rs)을 이 프로세스가 돌릴지. 로컬에서 잠깐 꺼둘 때 쓴다.
# SCHEDULER_ENABLED=true
# 스케줄러 실행 기록의 보관 기간(일). 그 기록은 이력이자 중복 실행을 막는 락이므로
# 짧게 잡지 말 것 — 최소 1 이상이어야 하고, 아니면 기동에 실패한다.
# SCHEDULER_RUN_RETENTION_DAYS=30
# 세션 유지 일 수
# SESSION_AGE_DAYS=30